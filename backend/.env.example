# Copy this file to `.env` and paste your key. `.env` is gitignored.
#
# Intent classification on questions no synonym matches. This is the
# higher-value use: the query-understanding failures were retrieval
# misses, not writing problems.
GROQ_API_KEY=

# Optional. Also use an LLM to write the answer.
# Leave unset to use the extractive path, which composes the answer
# directly from the retrieved fact and cannot hallucinate.
# MF_LLM=groq
